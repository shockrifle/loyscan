<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- The scanner needs a camera, but cards can always be entered by hand. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Android 11+ shows the app only the camera apps it asks for: a card photo is taken with one (#10). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".LoyScanApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LoyScan">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LoyScan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Share -> LoyScan: one picture, read for a card's barcode (#77). The same app as MainActivity, in a task with no
             affinity: the launcher and a widget tap (MainActivity's own) never reach a share left open, so they neither
             stack on its flow nor replace it. Every share is a task of its own, whatever flags its sender sets, so it never
             stacks on another share's flow either (#189). Standard launch mode, so a share never replaces an open screen
             (#83). -->
        <activity
            android:name=".ShareActivity"
            android:documentLaunchMode="always"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@style/Theme.LoyScan">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- Share -> LoyScan as a store logo (#151): a second share target, so the share sheet lists "Set as store logo"
             beside LoyScan. An alias of the share activity (its task, #189; its launch mode, #83); the intent names the alias. -->
        <activity-alias
            android:name=".ShareAsStoreLogo"
            android:exported="true"
            android:label="@string/share_as_store_logo"
            android:targetActivity=".ShareActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>
        <!-- Home-screen widget: the user's cards as tiles, each opening its card (#11). -->
        <receiver
            android:name=".widget.glance.CardWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/card_widget_info" />
        </receiver>
        <!-- Hands the camera app the file to write a card photo into (#10). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/card_photo_paths" />
        </provider>
    </application>

</manifest>