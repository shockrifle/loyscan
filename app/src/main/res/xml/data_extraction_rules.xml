<?xml version="1.0" encoding="utf-8"?><!--
   What Android 12+ backs up. See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   Card photos (#10) stay out of cloud backup, and go to a new phone by device-to-device transfer, which has no rules
   here and so takes everything. Turning the rest of cloud backup off is #71.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="card_photos/" />
    </cloud-backup>
</data-extraction-rules>
