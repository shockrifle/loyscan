<?xml version="1.0" encoding="utf-8"?><!--
   What Android 10 and 11 back up; Android 12+ reads data_extraction_rules.xml instead.
   See https://developer.android.com/guide/topics/data/autobackup
   Card photos (#10) stay out of cloud backup. On these versions device-to-device transfer follows the same rules, so it
   doesn't take them either. The rest of the backup rules are #71.
-->
<full-backup-content>
    <exclude domain="file" path="card_photos/" />
</full-backup-content>
