<?xml version="1.0" encoding="utf-8"?><!--
   What Android 10 and 11 back up; Android 12+ reads data_extraction_rules.xml instead.
   See https://developer.android.com/identity/data/autobackup#include-exclude-android-11
   These versions have one rule set for both cloud backup and device-to-device transfer. Cloud backup must carry no
   app data (#71), but a new phone must still get all of it. An <include> makes the file include-only (the default
   "back up everything" is dropped), and requireFlags="deviceToDeviceTransfer" limits each include to the transfer:
   the cloud backup doesn't set that flag, so it is left with nothing, while a new phone gets the Room database, the
   DataStore preferences and the card photos (#10). Opt-in cloud backup is #24.
-->
<full-backup-content>
    <include domain="root" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="sharedpref" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="external" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="device_root" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="device_file" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="device_database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="device_sharedpref" path="." requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
