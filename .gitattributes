# Wiki changelog is append-only, one self-contained line per entry; union-merge concurrent appends.
wiki/_log.md merge=union
# Shell scripts run under bash (Git Bash on Windows too), which breaks on CRLF.
*.sh text eol=lf
# Workflow files: ReleaseWorkflowTest reads release.yml's text and compares it with \n-only strings, so a Windows
# checkout (core.autocrlf) with CRLF would fail it (#170). GitHub reads them as LF anyway.
.github/workflows/*.yml text eol=lf
# Play listing texts: StoreListingTest counts their characters against Play's limits, so a Windows checkout's CRLF
# must not change them (#75).
play/listing/**/*.txt text eol=lf
